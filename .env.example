# 환경변수 템플릿 — 실제 값은 .env 에 (gitignore 됨)
#
# PostgreSQL 16 로컬 설치 (winget):
#   winget install --id PostgreSQL.PostgreSQL.16 --silent --accept-package-agreements --accept-source-agreements \
#     --override "--mode unattended --unattendedmodeui none --superpassword <SUPER_PWD> \
#                 --servicename postgresql-x64-16 --servicepassword <SUPER_PWD> --serverport 5432"
#
# 앱 DB/사용자 생성:
#   psql -U postgres -c "CREATE USER segformer WITH PASSWORD '<APP_PWD>';"
#   psql -U postgres -c "CREATE DATABASE segformer_v1 OWNER segformer ENCODING 'UTF8';"

DATABASE_URL=postgresql+psycopg://segformer:<APP_PWD>@localhost:5432/segformer_v1
DATABASE_URL_ASYNC=postgresql+asyncpg://segformer:<APP_PWD>@localhost:5432/segformer_v1

APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
